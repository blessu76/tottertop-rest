{
  "releases_file": "content/releases.json",
  "style": "releases",
  "langs": ["ko", "en"],
  "build": "python3 scripts/build_site.py",
  "check": "python3 scripts/check_release.py --all",
  "commit_paths": [
    "content/releases.json",
    "content/pages",
    "changelog",
    "ko/changelog",
    "ja/changelog",
    "zh/changelog",
    "es/changelog",
    "fr/changelog",
    "de/changelog",
    "pt/changelog",
    "ru/changelog",
    "ar/changelog",
    "hi/changelog",
    "scripts/build_site.py",
    "scripts/check_release.py",
    "tests",
    "ipe_release.json"
  ],
  "push_blackout": ["10:00-11:00", "13:00-14:30"],
  "branch": "main"
}
